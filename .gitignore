# ==========================================
# AdaptiveAI Platform Git Ignore
# ==========================================

# Dependencies
node_modules/
/.pnp
.pnp.js

# Environment Variables & Secrets (NEVER COMMIT API KEYS)
.env
.env.*
!.env.example

# Build Artifacts
/client/dist/
dist/
build/

# User Uploads (Keep directory with .gitkeep)
/server/uploads/*
!/server/uploads/.gitkeep
*.pdf

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Temporary folders
user_repo/
scratch/
