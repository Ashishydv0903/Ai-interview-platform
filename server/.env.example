# ==========================================
# AdaptiveAI Platform Environment Variables
# ==========================================

# Server Port (default: 5001)
PORT=5001

# ------------------------------------------
# MongoDB Database Connection
# ------------------------------------------
# Paste your MongoDB Atlas or local MongoDB connection URI here:
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/adaptive_interview?retryWrites=true&w=majority
# (If left empty, the server automatically uses local JSON persistence in /server/data/)
MONGODB_URI=

# ------------------------------------------
# Google Gemini AI API Key
# ------------------------------------------
# Get a free API key from Google AI Studio (https://aistudio.google.com/)
# (If left empty, the system automatically uses the built-in offline NLP engine & question bank)
GEMINI_API_KEY=

# ------------------------------------------
# JWT Authentication Secret Key
# ------------------------------------------
# Secret key used to sign and verify JSON Web Tokens for user login and registration:
JWT_SECRET=your_super_secret_jwt_key_change_in_production
